        "jsCode": "const items = $input.all();\nconst result = [];\n\nfor (const item of items) {\n    const data = item.json.data || \"\";\n\n    // 使用正規表達式抓出網址與標題\n    const linkRegex = /<a class=\"articleList_box\" href=\"([^\"]+)\">/g;\n    const titleRegex = /<div class=\"title\">([^<]+)<\\/div>/g;\n\n    // 將所有匹配到的結果提取出來\n    const links = [...data.matchAll(linkRegex)].map(m => m[1]);\n    const titles = [...data.matchAll(titleRegex)].map(m => m[1]);\n\n    // 將標題和網址配對組合\n    const length = Math.min(links.length, titles.length);\n    for (let i = 0; i < length; i++) {\n        const fullLink = 'https://www.informationsecurity.com.tw' + links[i];\n        \n        result.push({\n            json: {\n                title: titles[i].trim(),\n                link: fullLink\n            }\n        });\n    }\n}\n\nreturn result;"
      },
